<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../xsd/skills.xsd">

    <skill id="9901" levels="1" name="TT Heavy Armor Set">
        <!-- Increases MaxHP, P.Def and resistance to Sleep/Hold attack. STR+2, DEX-2 -->
        <icon>icon.skill0231</icon>
        <operateType>P</operateType>
        <targetType>SELF</targetType>
        <magicLevel>75</magicLevel>
        <effects>
            <effect name="Buff">
                <mul stat="pDef">1.10</mul> <!-- P Def. +10% -->
                <add stat="maxHp">750</add> <!-- Maximum HP +750 -->
                <mul stat="pAtk">1.10</mul> <!-- P. Atk +10% -->
            </effect>
            <effect name="DefenceTrait">
                <SLEEP>70</SLEEP>
                <HOLD>70</HOLD>
            </effect>
        </effects>
    </skill>
    <skill id="9902" levels="1" name="TT Robe Set">
        <!-- Increases M.Atk, moving speed, max weight limit, and resistance to Shock attack.
		Decreases chance of magic casting being canceled. WIT+1, INT+1, MEN-2 -->
        <icon>icon.skill0234</icon>
        <operateType>P</operateType>
        <targetType>SELF</targetType>
        <magicLevel>75</magicLevel>
        <effects>
            <effect name="Buff">
                <mul stat="mAtk">1.17</mul> <!-- M. Atk +17% -->
                <mul stat="pDef">1.10</mul> <!-- P. Def. +10% -->
                <mul stat="mAtkSpd">1.16</mul> <!-- Casting Speed +16% -->
                <add stat="runSpd">7</add> <!-- Movement Speed +7 -->
                <sub stat="cancel">50</sub> <!-- Casting Cancel Probability -50% -->
                <add stat="weightPenalty">5759</add> <!-- Point at which a weight penalty is applied
				+5759 -->
            </effect>
            <effect name="DefenceTrait">
                <SHOCK>50</SHOCK>
            </effect>
        </effects>
    </skill>
    <skill id="9903" levels="1" name="TT Light Set">
        <!-- Increases MaxHP, Atk.Spd, P.Atk, and Max weight limit. DEX+1, STR+1, CON-2 -->
        <icon>icon.skill0233</icon>
        <operateType>P</operateType>
        <targetType>SELF</targetType>
        <magicLevel>75</magicLevel>
        <effects>
            <effect name="Buff">
                <mul stat="pAtkSpd">1.06</mul> <!-- Attack Speed +6% -->
                <mul stat="pAtk">1.06</mul> <!-- P. Atk +6% -->
                <add stat="maxMp">489</add> <!-- Maximum MP +289 -->
                <add stat="weightPenalty">5759</add> <!-- Point at which a weight penalty is applied
				+5759 -->
            </effect>
        </effects>
    </skill>
</list>